# Generated by deploy/macos/install.sh
# Do not commit a filled copy. Secrets live in:
#   ~/Library/Application Support/cokacremote/env

COKACREMOTE_HOME=/absolute/path/to/feedback-remote
COKACREMOTE_NODE=/usr/local/bin/node

MCP_HOST=127.0.0.1
MCP_PORT=3001
MCP_ALIAS_HOST=127.0.0.1
MCP_ALIAS_PORT=3000
MCP_ENDPOINT=/mcp
MCP_PUBLIC_URL=https://your-machine.tailnet.ts.net
MCP_ALLOWED_HOSTS=your-machine.tailnet.ts.net,127.0.0.1,localhost
MCP_TRUST_PROXY_HOPS=1

MCP_AUTH_TOKEN=
MCP_ALLOW_NO_AUTH=false
MCP_OAUTH_ENABLED=true
MCP_OAUTH_APPROVAL_KEY=replace-with-openssl-rand-hex-32
MCP_OAUTH_ISSUER=https://your-machine.tailnet.ts.net
MCP_OAUTH_RESOURCE=https://your-machine.tailnet.ts.net/mcp
MCP_OAUTH_STATE_FILE="/Users/you/Library/Application Support/cokacremote/oauth-state.json"
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300

MCP_DEFAULT_CWD=/Users/you
MCP_DEFAULT_SHELL=/bin/zsh

MCP_MAX_REQUEST_BODY=8mb
MCP_MAX_OUTPUT_BYTES=1048576
MCP_MAX_RETAINED_PROCESS_OUTPUT_BYTES=4194304
MCP_PROCESS_RETENTION_MS=3600000
MCP_MAX_PROCESSES=128
MCP_MAX_FILE_CHUNK_BYTES=1048576
MCP_MAX_EDIT_FILE_BYTES=67108864
